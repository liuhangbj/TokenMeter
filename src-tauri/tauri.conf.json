{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenMeter",
  "version": "0.9.3",
  "identifier": "com.hangbits.tokenmeter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzREM5QzgxNkREOTE5NTMKUldSVEdkbHRnWnpjSTdzZmcwOVBvOWRjQS81VTMveEpHUFhnWktHMkVTUGVYOW02UGk5ZzhoV3cK",
      "endpoints": [
        "https://github.com/liuhangbj/TokenMeter/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
